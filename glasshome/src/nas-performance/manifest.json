{
  "name": "NAS Performance",
  "description": "Buffalo NAS CPU and memory history with network throughput.",
  "icon": "mdi:chart-line",
  "minSize": {
    "w": 3,
    "h": 4
  },
  "maxSize": {
    "w": 12,
    "h": 8
  },
  "defaultSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.23.1",
  "capabilities": [
    {
      "domain": "sensor",
      "access": "read"
    }
  ],
  "version": "0.1.0",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "cpu": {
        "default": [],
        "domain": "sensor",
        "title": "CPU usage",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "memory": {
        "default": [],
        "domain": "sensor",
        "title": "Memory usage",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rx": {
        "default": [],
        "domain": "sensor",
        "title": "Network RX bytes",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tx": {
        "default": [],
        "domain": "sensor",
        "title": "Network TX bytes",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "cpu",
      "memory",
      "rx",
      "tx"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "cpu": [],
    "memory": [],
    "rx": [],
    "tx": []
  }
}
